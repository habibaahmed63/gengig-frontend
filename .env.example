VITE_API_URL=https://gengig-backend.vercel.app
VITE_API_PROXY_TARGET=https://gengig-backend.vercel.app
VITE_USE_SAME_ORIGIN_API=true

# Keep this false when backend is on Vercel serverless (no Socket.IO server support).
VITE_ENABLE_SOCKET=false

# Enable only if you deploy realtime to a WebSocket-capable host.
# VITE_ENABLE_SOCKET=true
# VITE_SOCKET_URL=https://your-realtime-backend.example.com
